{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo \"static: web/static\"",
  "outputDirectory": "web/static",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "**"
    }
  },
  "rewrites": [
    { "source": "/api/config", "destination": "/api?route=config" },
    { "source": "/api/stats", "destination": "/api?route=stats" },
    { "source": "/api/examples/:id", "destination": "/api?route=example&id=:id" },
    { "source": "/api/clarify", "destination": "/api?route=clarify" },
    { "source": "/api/agent", "destination": "/api?route=agent" },
    { "source": "/api/finish", "destination": "/api?route=finish" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
